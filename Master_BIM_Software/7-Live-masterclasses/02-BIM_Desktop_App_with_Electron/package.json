{
  "name": "live-02-bim-desktop-electron",
  "version": "1.0.0",
  "private": true,
  "description": "Desktop BIM-GIS viewer built with Electron and That Open Engine.",
  "author": "Master BIM Software contributors",
  "type": "module",
  "main": "electron/main.cjs",
  "workspaces": [
    "viewer"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/copy-wasm.mjs && vite build && npm run build --workspace viewer && node scripts/copy-viewer.mjs",
    "start": "npm run build && node scripts/start.mjs",
    "make": "npm run build && electron-forge make"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@vitejs/plugin-react": "^6.2.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "electron": "^45.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
